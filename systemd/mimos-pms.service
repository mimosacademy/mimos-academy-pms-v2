[Unit]
Description=MIMOS Academy PMS - PocketBase
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mimos-pms
Group=mimos-pms
WorkingDirectory=/var/www/mimos-pms/apps/pocketbase
EnvironmentFile=/etc/mimos-pms/pocketbase.env
ExecStart=/var/www/mimos-pms/apps/pocketbase/pocketbase serve --http=127.0.0.1:8090 --encryptionEnv=PB_ENCRYPTION_KEY --dir=/var/www/mimos-pms/apps/pocketbase/pb_data --migrationsDir=/var/www/mimos-pms/apps/pocketbase/pb_migrations --hooksDir=/var/www/mimos-pms/apps/pocketbase/pb_hooks --hooksWatch=false
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/www/mimos-pms/apps/pocketbase/pb_data
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
